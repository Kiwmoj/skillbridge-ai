# Copy to backend/.env on the backend host. Never put this file in Git.
# The service owner configures this once; desktop students never see it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Generate an independent signing secret for account sessions.
SKILLBRIDGE_SECRET_KEY=
SKILLBRIDGE_SERVER_DATABASE_URL=sqlite:///./data/server.sqlite3
SKILLBRIDGE_AI_DAILY_LIMIT=40

# Optional external live opportunity search provider. Without it, no search
# results are returned and the UI reports search as unavailable.
BRAVE_SEARCH_API_KEY=

# Optional SMTP settings are required to enable password reset email.
SKILLBRIDGE_SMTP_HOST=
SKILLBRIDGE_SMTP_PORT=587
SKILLBRIDGE_SMTP_USERNAME=
SKILLBRIDGE_SMTP_PASSWORD=
SKILLBRIDGE_SMTP_SENDER=

# Production reverse proxy / web deployment options.
SKILLBRIDGE_ALLOWED_ORIGINS=
