# Optional local configuration. The app also supports a key saved once in the
# operating system credential store from Gemini Setup.
# Do not commit .env or put a real API key in this example file.
GEMINI_API_KEY=
# GOOGLE_API_KEY is also supported; if both are set, it takes precedence.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: override the local SQLite database location.
# SKILLBRIDGE_DB_PATH=./data/skillbridge.sqlite3
